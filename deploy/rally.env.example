# Copy to a private .env file and set actual values. No credentials belong here.
HOST=127.0.0.1
PORT=3000
# Exact public page origins, comma separated; no trailing slash or wildcard.
ALLOWED_ORIGINS=https://rally.example
# Empty uses same host as current page. Split frontend needs wss://host/ws.
PUBLIC_WS_URL=
# Browser game clients always send Origin; keep public deployments strict.
ALLOW_MISSING_ORIGIN=0
# Keep this file on persistent storage and writable by the Node service user.
# Default when omitted: <project>/data/leaderboard.json
LEADERBOARD_PATH=/var/lib/rally/leaderboard.json
# Optional direct Node HTTPS. Both paths are required together.
# TLS_KEY_PATH=/private/path/privkey.pem
# TLS_CERT_PATH=/private/path/fullchain.pem
